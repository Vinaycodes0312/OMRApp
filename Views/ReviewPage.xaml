<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OMRApp.Views.ReviewPage"
             Title="Review Answers">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="10,0,10,10" Spacing="5">
                <Label Text="Your Selected Answers" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                <CollectionView x:Name="ReviewCollectionView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding QuestionNumber}" FontSize="18"/>
                                <Label Text="{Binding SelectedAnswer}" FontSize="18" TextColor="Blue"/>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
