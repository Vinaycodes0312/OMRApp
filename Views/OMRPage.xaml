<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OMRApp.Views.OMRPage"
             Title="OMR Sheet">

    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="10,0,10,10" Spacing="5">
                <Label Text="Fill Your OMR Sheet" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Margin="0,5,0,5"/>

                <CollectionView x:Name="OMRCollectionView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="50, Auto, Auto, Auto, Auto" Padding="5" VerticalOptions="Center">
                                <!-- Fixed width for Question Number -->
                                <Label Text="{Binding QuestionNumber}" 
                                       FontSize="18" 
                                       VerticalOptions="Center"
                                       HorizontalOptions="End"
                                       WidthRequest="40"
                                       Margin="0,0,10,0"/>

                                <!-- Option A -->
                                <StackLayout Grid.Column="1" Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
                                    <Label Text="A" FontSize="18" VerticalOptions="Center"/>
                                    <RadioButton GroupName="{Binding QuestionNumber}" IsChecked="{Binding IsASelected, Mode=TwoWay}"/>
                                </StackLayout>

                                <!-- Option B -->
                                <StackLayout Grid.Column="2" Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
                                    <Label Text="B" FontSize="18" VerticalOptions="Center"/>
                                    <RadioButton GroupName="{Binding QuestionNumber}" IsChecked="{Binding IsBSelected, Mode=TwoWay}"/>
                                </StackLayout>

                                <!-- Option C -->
                                <StackLayout Grid.Column="3" Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
                                    <Label Text="C" FontSize="18" VerticalOptions="Center"/>
                                    <RadioButton GroupName="{Binding QuestionNumber}" IsChecked="{Binding IsCSelected, Mode=TwoWay}"/>
                                </StackLayout>

                                <!-- Option D -->
                                <StackLayout Grid.Column="4" Orientation="Horizontal" HorizontalOptions="Center" Spacing="5">
                                    <Label Text="D" FontSize="18" VerticalOptions="Center"/>
                                    <RadioButton GroupName="{Binding QuestionNumber}" IsChecked="{Binding IsDSelected, Mode=TwoWay}"/>
                                </StackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Review Answers" 
                        Clicked="OnReviewClicked" 
                        BackgroundColor="#ff5733" 
                        TextColor="White"
                        FontSize="18"
                        CornerRadius="10"
                        Margin="0,20,0,0"/>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
